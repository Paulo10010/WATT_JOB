// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Tabela para os usuários
model User {
  id        BigInt   @id @default(autoincrement())
  email     String   @unique
  password  String
  role      String
  processes Processo[] 
}

// Tabela para os processos
model Processo {
  id          BigInt   @id @default(autoincrement())
  armazem     String
  fibra       String
  status      String
  horaInicio  DateTime
  horaFim     DateTime? 
  user        User     @relation(fields: [userId], references: [id])
  userId      BigInt
}